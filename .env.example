# Copy to .env on the server (never commit .env). Used by docker-compose.prod.yml.
GHCR_OWNER=
RALLYTO_API_TAG=latest
POSTGRES_DB=rallyto
POSTGRES_USER=rallyto
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
PUBLIC_BASE_URL=
# The admin panel sign-in. Changing the password here and restarting resets it.
ADMIN_EMAIL=
ADMIN_PASSWORD=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_OTP_BODY_ID=
# The Firebase service-account JSON on one line (Rallyto's own Firebase project).
FIREBASE_CREDENTIALS_JSON=
