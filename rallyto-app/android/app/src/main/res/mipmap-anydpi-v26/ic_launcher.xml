<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive launcher icon (Android 8+): the reversed mark on the court-green gradient, and the mark alone for
     themed icons (Android 13+). The PNGs come from branding/build_brand.py; mipmap-*/ic_launcher.png is the tile for
     older launchers. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
