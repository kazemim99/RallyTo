---
/**
 * Where to get the app: the Android APK from this site and the web app for iPhone (`SITE.direct`), then the stores.
 * Until a store publishes it (`SITE.stores` is null) each store reads «به‌زودی» and links nowhere, so the page never
 * sends anyone to a missing listing.
 */
import { SITE } from '../config/site'
import BrandMark from './BrandMark.astro'

const STORES = [
  { key: 'bazaar', name: 'کافه‌بازار', url: SITE.stores.bazaar },
  { key: 'myket', name: 'مایکت', url: SITE.stores.myket },
] as const
const anyLive = STORES.some((s) => s.url)
---

<section class="section on-dark download" id="download" aria-labelledby="download-title">
  <div class="container download__inner">
    <div class="download__copy">
      <p class="kicker">دریافت اپ</p>
      <h2 id="download-title">بازی بعدی‌ات را همین هفته بچین</h2>
      <p class="muted download__lead">
        رالیتو رایگان است. روی اندروید فایل نصبی را مستقیم از همین‌جا بگیر؛ روی آیفون نسخه‌ی وب را باز کن و به صفحه‌ی
        اصلی گوشی اضافه‌اش کن.
      </p>
      <ul class="direct">
        <li>
          <a class="direct__link direct__link--main" href={SITE.direct.apk} download="rallyto.apk">
            <span class="direct__small">اندروید {SITE.direct.androidMin} و بالاتر</span>
            <span class="direct__name">دانلود مستقیم APK</span>
          </a>
        </li>
        <li>
          <a class="direct__link" href={SITE.direct.webApp} rel="noopener">
            <span class="direct__small">آیفون و هر گوشی دیگر</span>
            <span class="direct__name">نسخه‌ی وب رالیتو</span>
          </a>
        </li>
      </ul>
      <p class="direct__notes">
        <span>اگر اندروید پرسید، اجازه‌ی نصب از این منبع را بده.</span>
        <span>
          برای آیفون نسخه‌ی وب بهترین راه است: بدون اپ‌استور، در Safari بازش کن، دکمه‌ی اشتراک‌گذاری را بزن و
          «Add to Home Screen» را انتخاب کن تا مثل یک اپ از صفحه‌ی اصلی باز شود.
        </span>
      </p>
      <p class="muted download__stores-lead">
        {
          anyLive
            ? 'یا از فروشگاه دلخواهت نصبش کن:'
            : 'نسخه‌ی کافه‌بازار و مایکت هم به‌زودی منتشر می‌شود.'
        }
      </p>
      <ul class="stores">
        {
          STORES.map((s) =>
            s.url ? (
              <li>
                <a class="store" href={s.url} rel="noopener">
                  <span class="store__small">دریافت از</span>
                  <span class="store__name">{s.name}</span>
                </a>
              </li>
            ) : (
              <li>
                <span class="store store--soon">
                  <span class="store__small">به‌زودی در</span>
                  <span class="store__name">{s.name}</span>
                </span>
              </li>
            ),
          )
        }
      </ul>
    </div>
    <BrandMark size={220} tile class="download__mark" />
  </div>
</section>

<style>
  .download {
    position: relative;
    overflow: clip;
  }

  /* A court's lines, very faint, running off the block's edge. */
  .download::before {
    content: '';
    position: absolute;
    inset-block: -10% -10%;
    inset-inline-end: -8%;
    width: min(70vw, 760px);
    border: 2px solid rgb(255 255 255 / 7%);
    background:
      linear-gradient(rgb(255 255 255 / 7%), rgb(255 255 255 / 7%)) center / 2px 100% no-repeat,
      linear-gradient(rgb(255 255 255 / 7%), rgb(255 255 255 / 7%)) center / 100% 2px no-repeat;
    transform: rotate(-10deg);
    pointer-events: none;
  }

  .download__inner {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .download h2 {
    font-size: var(--step-4);
    line-height: 1.3;
  }

  .download__lead {
    max-width: 34rem;
    margin-block: 18px 26px;
    font-size: var(--step-1);
  }

  .direct {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  .direct__link {
    display: grid;
    min-width: 200px;
    min-height: 64px;
    padding: 10px 24px;
    border: 1.5px solid rgb(255 255 255 / 55%);
    border-radius: 18px;
    color: var(--c-surface);
    text-decoration: none;
    line-height: 1.5;
    transition:
      transform var(--dur-press) var(--ease-out),
      background-color var(--dur-ui) ease;
  }

  .direct__link--main {
    border-color: var(--c-ball);
    background: var(--c-ball);
    color: var(--c-deep);
  }

  .direct__link:active {
    transform: scale(0.97);
  }

  .direct__small {
    font-size: 0.8125rem;
  }

  .direct__name {
    font-weight: 700;
    font-size: var(--step-1);
  }

  .direct__notes {
    display: grid;
    gap: 4px;
    max-width: 36rem;
    margin-block: 14px 30px;
    color: var(--c-mint);
    font-size: var(--step--1);
    line-height: 1.9;
  }

  .download__stores-lead {
    margin-block-end: 12px;
    font-size: var(--step--1);
  }

  @media (hover: hover) and (pointer: fine) {
    .direct__link:not(.direct__link--main):hover {
      background: rgb(255 255 255 / 8%);
    }
  }

  .download__inner :global(.download__mark) {
    justify-self: center;
    width: clamp(120px, 24vw, 220px);
    height: auto;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 35%));
  }

  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  .store {
    display: grid;
    min-width: 170px;
    padding: 10px 24px;
    border-radius: 18px;
    background: var(--c-ball);
    color: var(--c-deep);
    text-decoration: none;
    line-height: 1.5;
    transition: transform var(--dur-press) var(--ease-out);
  }

  a.store:active {
    transform: scale(0.97);
  }

  .store--soon {
    background: rgb(255 255 255 / 6%);
    border: 1.5px dashed rgb(255 255 255 / 40%);
    color: var(--c-surface);
  }

  .store__small {
    font-size: 0.8125rem;
  }

  .store--soon .store__small {
    color: var(--c-mint);
  }

  .store__name {
    font-weight: 700;
    font-size: var(--step-1);
  }

  @media (min-width: 860px) {
    .download__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
</style>
