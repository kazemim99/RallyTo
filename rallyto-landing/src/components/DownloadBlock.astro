---
/**
 * Where to get the app. Until a store publishes it (`SITE.stores` is null) each store reads «به‌زودی» and links
 * nowhere, so the page never sends anyone to a missing listing.
 */
import { SITE } from '../config/site'
import BrandMark from './BrandMark.astro'

const STORES = [
  { key: 'bazaar', name: 'کافه‌بازار', url: SITE.stores.bazaar },
  { key: 'myket', name: 'مایکت', url: SITE.stores.myket },
] as const
const anyLive = STORES.some((s) => s.url)
---

<section class="section on-dark download" id="download" aria-labelledby="download-title">
  <div class="container download__inner">
    <div class="download__copy">
      <p class="kicker">دریافت اپ</p>
      <h2 id="download-title">بازی بعدی‌ات را همین هفته بچین</h2>
      <p class="muted download__lead">
        {
          anyLive
            ? 'رالیتو رایگان است. از فروشگاه دلخواهت نصبش کن، پروفایلت را بساز و اولین بازی‌ات را پیدا کن.'
            : 'رالیتو رایگان است. نسخه‌ی اندروید آن به‌زودی در کافه‌بازار و مایکت منتشر می‌شود.'
        }
      </p>
      <ul class="stores">
        {
          STORES.map((s) =>
            s.url ? (
              <li>
                <a class="store" href={s.url} rel="noopener">
                  <span class="store__small">دریافت از</span>
                  <span class="store__name">{s.name}</span>
                </a>
              </li>
            ) : (
              <li>
                <span class="store store--soon">
                  <span class="store__small">به‌زودی در</span>
                  <span class="store__name">{s.name}</span>
                </span>
              </li>
            ),
          )
        }
      </ul>
    </div>
    <BrandMark size={220} tile class="download__mark" />
  </div>
</section>

<style>
  .download {
    position: relative;
    overflow: clip;
  }

  /* A court's lines, very faint, running off the block's edge. */
  .download::before {
    content: '';
    position: absolute;
    inset-block: -10% -10%;
    inset-inline-end: -8%;
    width: min(70vw, 760px);
    border: 2px solid rgb(255 255 255 / 7%);
    background:
      linear-gradient(rgb(255 255 255 / 7%), rgb(255 255 255 / 7%)) center / 2px 100% no-repeat,
      linear-gradient(rgb(255 255 255 / 7%), rgb(255 255 255 / 7%)) center / 100% 2px no-repeat;
    transform: rotate(-10deg);
    pointer-events: none;
  }

  .download__inner {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .download h2 {
    font-size: var(--step-4);
    line-height: 1.3;
  }

  .download__lead {
    max-width: 34rem;
    margin-block: 18px 30px;
    font-size: var(--step-1);
  }

  .download__inner :global(.download__mark) {
    justify-self: center;
    width: clamp(120px, 24vw, 220px);
    height: auto;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 35%));
  }

  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  .store {
    display: grid;
    min-width: 170px;
    padding: 10px 24px;
    border-radius: 18px;
    background: var(--c-ball);
    color: var(--c-deep);
    text-decoration: none;
    line-height: 1.5;
    transition: transform var(--dur-press) var(--ease-out);
  }

  a.store:active {
    transform: scale(0.97);
  }

  .store--soon {
    background: rgb(255 255 255 / 6%);
    border: 1.5px dashed rgb(255 255 255 / 40%);
    color: var(--c-surface);
  }

  .store__small {
    font-size: 0.8125rem;
  }

  .store--soon .store__small {
    color: var(--c-mint);
  }

  .store__name {
    font-weight: 700;
    font-size: var(--step-1);
  }

  @media (min-width: 860px) {
    .download__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
</style>
