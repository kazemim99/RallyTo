---
import type { FaqItem } from '../data/sports'

/** Questions as disclosure widgets: readable without JavaScript, every answer in the HTML for search engines. */
interface Props {
  items: FaqItem[]
  heading?: string
  id?: string
}
const { items, heading = 'سؤال‌هایی که معمولاً می‌پرسند', id = 'faq' } = Astro.props
---

<section class="section faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="container faq__inner">
    <h2 id={`${id}-title`}>{heading}</h2>
    <div class="faq__list">
      {
        items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__inner {
    display: grid;
    gap: 32px;
  }

  .faq__list {
    border-top: 1px solid var(--c-line);
  }

  details {
    border-bottom: 1px solid var(--c-line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.65;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    flex: none;
    width: 12px;
    height: 12px;
    border: solid var(--c-court);
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg) translate(-3px, -3px);
    transition: transform 0.2s ease;
  }

  details[open] summary::after {
    transform: rotate(-135deg);
  }

  details p {
    max-width: var(--measure);
    padding-block-end: 22px;
    color: var(--c-muted);
  }

  @media (min-width: 960px) {
    .faq__inner {
      grid-template-columns: 1fr 2fr;
      gap: 64px;
      align-items: start;
    }
  }
</style>
