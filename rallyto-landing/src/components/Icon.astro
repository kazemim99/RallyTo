  phoneOff: 'M7 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z M9.5 18h2 M3 3l18 18',
  request: 'M4 5.5h16v10H9.5L5 19.5v-4H4z M12 8.5v3 M12 13.6v.1',
  star: 'm12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L12 3.5Z',
