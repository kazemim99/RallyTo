---
/** A small top-down court for one sport, in that sport's surface and line colours (the hero's courts, simplified). */
interface Props {
  sport: 'tennis' | 'padel' | 'badminton' | 'squash'
  class?: string
}
const { sport, class: className } = Astro.props
const SURFACE = { tennis: 'var(--c-tennis)', padel: 'var(--c-padel)', badminton: 'var(--c-badminton)', squash: 'var(--c-squash)' }
const LINE = sport === 'squash' ? 'var(--c-squash-line)' : '#ffffff'
---

<svg class:list={['mini-court', className]} viewBox="0 0 120 170" aria-hidden="true" focusable="false">
  <rect width="120" height="170" rx="14" fill={SURFACE[sport]}></rect>
  <g fill="none" stroke={LINE} stroke-width="2.5" stroke-linecap="round">
    {
      sport === 'tennis' && (
        <>
          <rect x="25" y="12" width="70" height="146" />
          <path d="M34 12v146M86 12v146M34 46h52M34 124h52M60 46v78" />
          <path d="M18 85h84" stroke-width="4" />
        </>
      )
    }
    {
      sport === 'padel' && (
        <>
          <rect x="24" y="16" width="72" height="138" />
          <path d="M24 37h72M24 133h72M60 37v96" />
          <path d="M20 85h80" stroke-width="4" />
          <path d="M22 13h76M22 157h76" stroke-width="5" stroke-opacity="0.6" />
        </>
      )
    }
    {
      sport === 'badminton' && (
        <>
          <rect x="28" y="16" width="64" height="138" />
          <path d="M33 16v138M87 16v138M28 64h64M28 106h64M28 24h64M28 146h64M60 16v48M60 106v48" />
          <path d="M22 85h76" stroke-width="4" />
        </>
      )
    }
    {
      sport === 'squash' && (
        <>
          <rect x="14" y="20" width="92" height="136" />
          <path d="M14 96h92M60 96v60M14 118h23V96M106 118H83V96" />
          <path d="M14 15h92" stroke-width="6" />
        </>
      )
    }
  </g>
</svg>

<style>
  .mini-court {
    width: 100%;
    height: auto;
  }
</style>
