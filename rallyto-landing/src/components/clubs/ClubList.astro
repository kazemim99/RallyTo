---
/**
 * Clubs as a plain list: each club's name, sports, address, phone, hours and the ways to reach it. A fact the catalog
 * does not have is left out, never guessed; only the address says so out loud, because a visitor is looking for it.
 */
import type { Club } from '../../data/clubs'
import Icon from '../Icon.astro'

interface Props {
  clubs: Club[]
  /** On a club's own page the h1 already names it: the entry shows only its sports and facts. */
  named?: boolean
}
const { clubs, named = true } = Astro.props
const faDigits = (s: string) => s.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)])
const OWN_LINKS = [
  ['website', 'وب‌سایت'],
  ['instagram', 'اینستاگرام'],
  ['telegram', 'تلگرام'],
] as const
---

<ul class="clubs">
  {
    clubs.map((club) => (
      <li class="club" data-sports={club.sports.map((s) => s.slug).join(' ')}>
        <div class="club__head">
          {named && (
            <a class="club__name" href={club.path}>
              {club.name}
            </a>
          )}
          <span class="club__sports">
            {club.sports.map((s) => (
              <span class:list={['chip', `chip--${s.slug}`]}>{s.name}</span>
            ))}
          </span>
        </div>

        <dl class="club__facts">
          <div>
            <dt>
              <Icon name="pin" size={18} />
              نشانی
            </dt>
            <dd>{club.address ? <address>{club.address}</address> : <span class="club__missing">نشانی دقیق ثبت نشده</span>}</dd>
          </div>
          {club.phone && (
            <div>
              <dt>
                <Icon name="phone" size={18} />
                تلفن
              </dt>
              <dd>
                <a class="club__phone" href={club.phone.href} dir="ltr">
                  {faDigits(club.phone.text)}
                </a>
              </dd>
            </div>
          )}
          {club.workingHours && (
            <div>
              <dt>
                <Icon name="clock" size={18} />
                ساعت کاری
              </dt>
              <dd>{club.workingHours}</dd>
            </div>
          )}
        </dl>

        {(club.map || club.website || club.instagram || club.telegram) && (
          <div class="club__links">
            {club.map && (
              <>
                <a class="club__link club__link--map" href={club.map.google} target="_blank" rel="noopener noreferrer nofollow" aria-label={`مشاهده روی نقشه: ${club.name}`}>
                  <Icon name="pin" size={18} />
                  مشاهده روی نقشه
                </a>
                <a class="club__link" href={club.map.balad} target="_blank" rel="noopener noreferrer nofollow" aria-label={`مشاهده در بلد: ${club.name}`}>
                  مشاهده در بلد
                </a>
              </>
            )}
            {OWN_LINKS.map(
              ([key, label]) =>
                club[key] && (
                  <a class="club__link" href={club[key]} target="_blank" rel="noopener noreferrer nofollow" aria-label={`${label}: ${club.name}`}>
                    <Icon name="link" size={18} />
                    {label}
                  </a>
                ),
            )}
          </div>
        )}

        {club.description && (
          <details class="club__about">
            <summary>درباره‌ی باشگاه</summary>
            <p>{club.description}</p>
          </details>
        )}
      </li>
    ))
  }
</ul>

<style>
  .clubs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-ink);
  }

  .club {
    display: grid;
    gap: 14px;
    padding-block: 22px;
    border-bottom: 1px solid var(--c-line);
  }

  .club[hidden] {
    display: none;
  }

  .club__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }

  .club__name {
    min-width: 0;
    color: var(--c-ink);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.6;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .club__sports {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    --dot: var(--c-tennis);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 10px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-ink);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 26px;
    white-space: nowrap;
  }

  .chip::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--dot);
  }

  .chip--padel { --dot: var(--c-padel); }
  .chip--badminton { --dot: var(--c-badminton); }
  .chip--squash { --dot: var(--c-squash); }

  .club__facts {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .club__facts > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 4px 12px;
    align-items: baseline;
  }

  .club__facts dt {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--c-muted);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .club__facts dt :global(.icon) {
    flex-shrink: 0;
  }

  .club__facts dd {
    min-width: 0;
    margin: 0;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .club__facts address {
    font-style: normal;
  }

  .club__missing {
    color: var(--c-muted);
  }

  .club__phone {
    display: inline-block;
    color: var(--c-court);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .club__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .club__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding-inline: 14px;
    border: 1.5px solid var(--c-line);
    border-radius: 12px;
    background: var(--c-surface);
    color: var(--c-ink);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
    transition:
      transform var(--dur-press) var(--ease-out),
      border-color var(--dur-ui) ease;
  }

  .club__link--map {
    border-color: var(--c-court);
    background: var(--c-court);
    color: #fff;
  }

  .club__link:active {
    transform: scale(0.98);
  }

  .club__about summary {
    width: fit-content;
    color: var(--c-court);
    font-size: var(--step--1);
    font-weight: 700;
    cursor: pointer;
  }

  .club__about p {
    max-width: 44rem;
    margin-block-start: 8px;
    color: var(--c-muted);
    line-height: 1.9;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) and (pointer: fine) {
    .club__link:hover {
      border-color: var(--c-court);
    }

    .club__name:hover {
      color: var(--c-court);
      text-decoration: underline;
    }
  }

  @media (max-width: 479px) {
    .club__facts > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
