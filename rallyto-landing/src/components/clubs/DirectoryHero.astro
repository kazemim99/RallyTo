---
/** The opening band of every directory page: where you are, the page's heading and lead, and the finder. */
import type { Crumb } from '../../lib/seo'
import Breadcrumbs from '../Breadcrumbs.astro'
import ClubFinder from '../ClubFinder.astro'

interface Props {
  crumbs: Crumb[]
  heading: string
  lead: string
  sport?: string
  province?: string
  city?: string
}
const { crumbs, heading, lead, sport, province, city } = Astro.props
---

<section class="dir-hero on-dark" aria-labelledby="dir-title">
  <div class="container">
    <Breadcrumbs crumbs={crumbs} />
    <h1 id="dir-title">{heading}</h1>
    <p class="dir-hero__lead">{lead}</p>
    <ClubFinder tone="dark" sport={sport} province={province} city={city} headingId="dir-title" />
  </div>
</section>

<style>
  .dir-hero {
    padding-block: 18px clamp(40px, 6vw, 72px);
  }

  .dir-hero h1 {
    max-width: 22ch;
    margin-block: 18px 14px;
    font-size: var(--step-4);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .dir-hero__lead {
    max-width: 44rem;
    margin-block-end: 28px;
    color: var(--c-mint);
    font-size: var(--step-1);
    line-height: 1.85;
  }
</style>
