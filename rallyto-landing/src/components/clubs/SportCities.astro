---
/** On a sport page: the cities with the most clubs for that sport, each linking to its directory page. */
import { CLUBS_PATH, citySportPath, topCitiesFor } from '../../data/clubs'
import type { Sport } from '../../data/sports'
import ClubFinder from '../ClubFinder.astro'

interface Props {
  sport: Sport
}
const { sport } = Astro.props
const top = topCitiesFor(sport, 12)
const fa = (n: number) => n.toLocaleString('fa-IR')
---

{
  top.length > 0 && (
    <section class="section sport-cities" id="clubs" aria-labelledby="sport-cities-title">
      <div class="container">
        <div class="section-head">
          <p class="kicker">باشگاه‌ها</p>
          <h2 id="sport-cities-title">باشگاه‌های {sport.name} در شهرها</h2>
          <p>شهرت را انتخاب کن تا باشگاه‌های {sport.name} همان‌جا را ببینی.</p>
        </div>
        <ul class="sport-cities__list">
          {top.map(({ city, count }) => (
            <li>
              <a href={citySportPath(city, sport)}>
                <span>{city.name}</span>
                <b>{fa(count)} باشگاه</b>
              </a>
            </li>
          ))}
        </ul>
        <ClubFinder sport={sport.slug} headingId="sport-cities-title" />
        <p class="sport-cities__all">
          <a href={CLUBS_PATH}>همه‌ی باشگاه‌ها به تفکیک استان و شهر</a>
        </p>
      </div>
    </section>
  )
}

<style>
  .sport-cities {
    background: var(--c-surface);
    border-block: 1px solid var(--c-line);
  }

  .sport-cities__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 0 32px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-ink);
  }

  .sport-cities__list a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 12px;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-ink);
    text-decoration: none;
    transition: color var(--dur-ui) ease;
  }

  .sport-cities__list b {
    color: var(--c-muted);
    font-weight: 400;
    font-size: var(--step--1);
  }

  .sport-cities__all {
    margin-block-start: 18px;
  }

  @media (hover: hover) and (pointer: fine) {
    .sport-cities__list a:hover {
      color: var(--c-court);
    }
  }
</style>
