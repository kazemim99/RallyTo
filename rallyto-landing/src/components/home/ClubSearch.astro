---
/** The club finder in the home page's hero: sport, province and city, into the club directory. Shown once the directory exists. */
import { CLUBS_PATH, DIRECTORY, totalClubs } from '../../data/clubs'
import ClubFinder from '../ClubFinder.astro'
import Icon from '../Icon.astro'

const fa = (n: number) => n.toLocaleString('fa-IR')
---

<section class="club-search" id="clubs" aria-labelledby="club-search-title">
  <div class="club-search__head">
    <h2 id="club-search-title">باشگاه پیدا کن</h2>
    <p>{fa(totalClubs())} باشگاه در {fa(DIRECTORY.length)} استان، با نشانی، تلفن و نقشه</p>
  </div>
  <ClubFinder layout="compact" headingId="club-search-title" />
  <a class="club-search__all" href={CLUBS_PATH}>
    همه‌ی باشگاه‌ها به تفکیک استان
    <Icon name="arrow" size={16} class="arrow" />
  </a>
</section>

<style>
  .club-search {
    display: grid;
    gap: 10px;
  }

  .club-search__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
  }

  .club-search__head h2 {
    font-size: var(--step-2);
    line-height: 1.5;
  }

  .club-search__head p {
    color: var(--c-muted);
    font-size: var(--step--1);
  }

  .club-search__all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    justify-self: start;
    min-height: 32px;
    color: var(--c-court);
    font-size: var(--step--1);
    font-weight: 700;
    text-decoration: none;
  }
</style>
