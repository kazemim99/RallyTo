---
import { PAGES } from '../data/pages'
import { SPORTS } from '../data/sports'
import Base from '../layouts/Base.astro'
---

<Base meta={PAGES.notFound}>
  <section class="nf on-dark" aria-labelledby="nf-title">
    <div class="container nf__inner">
      <p class="nf__code" aria-hidden="true">۴۰۴</p>
      <h1 id="nf-title">این توپ از زمین بیرون رفت</h1>
      <p class="nf__lead">صفحه‌ای که دنبالش بودی وجود ندارد. از اینجا ادامه بده:</p>
      <ul class="nf__links">
        <li><a class="btn btn--ball" href="/">صفحه اصلی رالیتو</a></li>
        {
          SPORTS.map((s) => (
            <li>
              <a class="btn btn--outline-light" href={`/${s.slug}`}>
                پارتنر {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: 48px 120px;
  }

  .nf__inner {
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .nf__code {
    font: 900 clamp(5rem, 18vw, 10rem) / 1 var(--font-display);
    color: var(--c-ball);
  }

  .nf__lead {
    color: var(--c-mint);
    font-size: var(--step-1);
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    list-style: none;
  }
</style>
