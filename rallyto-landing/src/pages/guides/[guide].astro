---
/** A guide: how a sport is played and scored, then where to play it and where to find a partner for it. */
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import DownloadBlock from '../../components/DownloadBlock.astro'
import Faq from '../../components/Faq.astro'
import { citySportPath, directoryPublished, topCitiesFor } from '../../data/clubs'
import { GUIDES, GUIDES_PATH, type Guide } from '../../data/guides'
import { guidePage, publishedSports } from '../../data/pages'
import { SPORTS } from '../../data/sports'
import Base from '../../layouts/Base.astro'
import { articleLd } from '../../lib/seo'

export function getStaticPaths() {
  return GUIDES.map((guide) => ({ params: { guide: guide.slug }, props: { guide } }))
}

interface Props {
  guide: Guide
}
const { guide } = Astro.props
const meta = guidePage(guide)
const fa = (n: number) => n.toLocaleString('fa-IR')
const sports = SPORTS.filter((s) => guide.sports.includes(s.slug))
const partnerPages = new Set(publishedSports().map((s) => s.slug))
const others = GUIDES.filter((g) => g !== guide)
const ld = articleLd(meta.path, guide.h1, guide.description, guide.published, guide.figure?.src)
---

<Base meta={meta} jsonLd={[ld]}>
  <section class="guide-hero on-dark" aria-labelledby="guide-title">
    <div class="container">
      <Breadcrumbs crumbs={meta.crumbs!} />
      <h1 id="guide-title">{guide.h1}</h1>
      <p class="guide-hero__lead">{guide.lead}</p>
    </div>
  </section>

  <div class="section">
    <div class="container guide">
      <article class="guide__body">
        {
          guide.figure && (
            <figure>
              <img src={guide.figure.src} alt={guide.figure.alt} width={guide.figure.width} height={guide.figure.height} decoding="async" />
              <figcaption>{guide.figure.caption}</figcaption>
            </figure>
          )
        }
        {
          guide.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.paragraphs.map((p) => <p>{p}</p>)}
              {section.list && (
                <ul>
                  {section.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {section.table && (
                <div class="guide__table">
                  <table>
                    <caption>{section.table.caption}</caption>
                    <thead>
                      <tr>
                        {section.table.head.map((h) => (
                          <th scope="col">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map(([label, ...cells]) => (
                        <tr>
                          <th scope="row">{label}</th>
                          {cells.map((c) => (
                            <td>{c}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {section.figure && (
                <figure>
                  <img
                    src={section.figure.src}
                    alt={section.figure.alt}
                    width={section.figure.width}
                    height={section.figure.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{section.figure.caption}</figcaption>
                </figure>
              )}
            </section>
          ))
        }
      </article>

      <aside class="guide__aside" aria-label="در رالیتو">
        {
          sports.map((sport) => {
            const cities = directoryPublished() ? topCitiesFor(sport, 6) : []
            return (
              <div class="aside-box">
                <h2>{sport.name} در رالیتو</h2>
                {partnerPages.has(sport.slug) && (
                  <p>
                    <a class="aside-box__main" href={`/${sport.slug}`}>
                      پیدا کردن هم‌بازی {sport.name} هم‌سطح
                    </a>
                  </p>
                )}
                {cities.length > 0 && (
                  <>
                    <h3>باشگاه‌های {sport.name}</h3>
                    <ul>
                      {cities.map(({ city, count }) => (
                        <li>
                          <a href={citySportPath(city, sport)}>
                            {city.name} <span>({fa(count)})</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            )
          })
        }
        <div class="aside-box">
          <h2>راهنماهای دیگر</h2>
          <ul>
            {
              others.map((g) => (
                <li>
                  <a href={`${GUIDES_PATH}/${g.slug}`}>{g.crumb}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>

  <Faq items={guide.faq} heading={`سؤال‌های پرتکرار: ${guide.crumb}`} />
  <DownloadBlock />
</Base>

<style>
  .guide-hero {
    padding-block: 18px clamp(40px, 6vw, 72px);
  }

  .guide-hero h1 {
    max-width: 22ch;
    margin-block: 18px 14px;
    font-size: var(--step-4);
    line-height: 1.3;
  }

  .guide-hero__lead {
    max-width: 44rem;
    color: var(--c-mint);
    font-size: var(--step-1);
    line-height: 1.85;
  }

  .guide {
    display: grid;
    gap: 48px;
  }

  .guide__body {
    display: grid;
    gap: 36px;
    max-width: var(--measure);
  }

  .guide__body section {
    display: grid;
    gap: 12px;
  }

  .guide__body h2 {
    font-size: var(--step-2);
  }

  .guide__body p,
  .guide__body li {
    line-height: 2;
  }

  .guide__body ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-inline-start: 1.2em;
  }

  .guide__table {
    overflow-x: auto;
  }

  .guide__body figure {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  .guide__body img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
  }

  .guide__body figcaption {
    color: var(--c-muted);
    font-size: var(--step--1);
    line-height: 1.8;
  }

  .guide__body table {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .guide__body caption {
    margin-block-end: 8px;
    color: var(--c-muted);
    text-align: start;
  }

  .guide__body th,
  .guide__body td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--c-line);
    text-align: start;
    vertical-align: top;
    line-height: 1.8;
  }

  .guide__body thead th {
    border-bottom: 1.5px solid var(--c-ink);
  }

  .guide__body tbody th {
    font-weight: 700;
    white-space: nowrap;
  }

  .guide__aside {
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .aside-box {
    padding: 22px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-l);
    background: var(--c-surface);
  }

  .aside-box h2 {
    margin-block-end: 12px;
    font: 700 var(--step-1) / 1.6 var(--font-body);
  }

  .aside-box h3 {
    margin-block: 16px 8px;
    color: var(--c-muted);
    font: 700 var(--step--1) / 1.6 var(--font-body);
  }

  .aside-box ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aside-box a {
    color: var(--c-ink);
    text-decoration: none;
  }

  .aside-box a span {
    color: var(--c-muted);
  }

  .aside-box .aside-box__main {
    color: var(--c-court);
    font-weight: 700;
  }

  @media (hover: hover) and (pointer: fine) {
    .aside-box a:hover {
      color: var(--c-court);
      text-decoration: underline;
    }
  }

  @media (min-width: 960px) {
    .guide {
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: 64px;
    }
  }
</style>
