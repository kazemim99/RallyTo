---
import DownloadBlock from '../components/DownloadBlock.astro'
import Faq from '../components/Faq.astro'
import SportTiles from '../components/SportTiles.astro'
import CourtScene from '../components/home/CourtScene.astro'
import GroupChat from '../components/home/GroupChat.astro'
import Safety from '../components/home/Safety.astro'
import Steps from '../components/home/Steps.astro'
import Venues from '../components/home/Venues.astro'
import ClubSearch from '../components/home/ClubSearch.astro'
import { directoryPublished } from '../data/clubs'
import Icon from '../components/Icon.astro'
import type { IconName } from '../components/Icon.astro'
import { SPORTS } from '../data/sports'
import { SITE } from '../config/site'
import { HOME_FAQ } from '../data/faq'
import { PAGES } from '../data/pages'
import Base from '../layouts/Base.astro'
import { mobileApplicationLd, organizationLd, websiteLd } from '../lib/seo'

const storesLive = Object.values(SITE.stores).some(Boolean)
const faDigits = (n: number) => n.toLocaleString('fa-IR')

// Facts, not figures: each is a rule of the app today (src/data/faq.ts and src/data/sports.ts hold the details).
const levelCount = Math.min(...SPORTS.map((s) => s.levels.length))
const PROOF = [
  { value: 'رایگان', label: 'ساختن حساب، بازی، جستجو و گفتگو' },
  { value: `${faDigits(SPORTS.length)} ورزش`, label: `هر کدام با ${faDigits(levelCount)} سطح جداگانه` },
  { value: '۳۱ استان', label: 'هم‌بازی بر اساس شهر، باشگاه و ساعت' },
  { value: 'شماره پنهان', label: 'هماهنگی فقط داخل اپ' },
]

// Each line is a feature the app has today (see src/data/faq.ts for the rules behind them).
const SAFETY: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'reliable',
    title: 'خوش‌قولی هر بازیکن، روی پروفایلش',
    text: 'بعد از هر بازی حضورها ثبت می‌شود. از ۲۰ تعهد آخر هر بازیکن، خوش‌قولی‌اش با «عالی»، «خوب» یا «کم» روی پروفایل دیده می‌شود.',
  },
  {
    icon: 'star',
    title: 'امتیاز دوطرفه و پنهان',
    text: 'امتیازی که می‌دهی تا هم‌بازی‌ات هم امتیاز ندهد یا ۷ روز نگذرد حساب نمی‌شود و امتیازهای تکی به هیچ‌کس نشان داده نمی‌شود؛ جایی برای تلافی نمی‌ماند.',
  },
  {
    icon: 'request',
    title: 'اول درخواست، بعد گفتگو',
    text: 'غریبه‌ها فقط یک پیام می‌توانند بفرستند؛ گفتگو وقتی باز می‌شود که تو درخواست را بپذیری.',
  },
  {
    icon: 'shield',
    title: 'فقط هم‌جنس‌ها، اگر بخواهی',
    text: 'با «فقط هم‌جنس‌ها مرا ببینند» پروفایل و بازی‌هایت فقط به هم‌جنس‌ها نشان داده می‌شود، و بازی را می‌توانی «فقط خانم‌ها» منتشر کنی.',
  },
  {
    icon: 'phoneOff',
    title: 'شماره‌ات نمایش داده نمی‌شود',
    text: 'همه‌ی هماهنگی‌ها داخل رالیتو انجام می‌شود و شماره‌ی تلفنت به هیچ بازیکنی نشان داده نمی‌شود.',
  },
  {
    icon: 'flag',
    title: 'گزارش و مسدود کردن',
    text: 'هر کسی را بی‌خبر از خودش مسدود کن و هر بازیکن، پیام، پست یا عکسی را گزارش بده؛ مدیران رالیتو گزارش‌ها را بررسی می‌کنند.',
  },
]
---

<Base meta={PAGES.home} jsonLd={[organizationLd(), websiteLd(), mobileApplicationLd()]} headerTone="light">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__sports">
          {
            SPORTS.map((s) => (
              <span class:list={['hero__sport', `hero__sport--${s.slug}`]}>{s.name}</span>
            ))
          }
        </p>
        <h1 id="hero-title">
          هم‌بازیِ هم‌سطح،
          <span class="hero__accent">
            نزدیک باشگاهت
            <svg class="hero__swash" viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d="M3 13C70 5 160 3 297 9" />
            </svg>
          </span>
        </h1>
        <p class="hero__lead">
          رالیتو برای تنیس، پدل، بدمینتون و اسکواش هم‌بازی پیدا می‌کند: هم‌سطح خودت، نزدیک باشگاهت و در ساعتی که آزادی.
        </p>
        {
          directoryPublished() && (
            <div class="hero__finder">
              <ClubSearch />
            </div>
          )
        }
        <div class="hero__actions">
          <a class:list={['btn', directoryPublished() ? 'btn--ghost' : 'btn--court']} href="#download">
            دریافت اپ
            <Icon name="arrow" size={20} class="arrow" />
          </a>
          <a class="btn btn--ghost" href="#how">ببین چطور کار می‌کند</a>
        </div>
        <p class="hero__note">
          {storesLive ? 'رالیتو رایگان است.' : 'رالیتو رایگان است؛ اندروید را مستقیم دانلود کن و روی آیفون نسخه‌ی وب را باز کن.'}
        </p>
      </div>
      <div class="hero__stage on-dark">
        <CourtScene />
      </div>
    </div>

    <div class="container">
      <ul class="proof" aria-label="رالیتو در یک نگاه">
        {
          PROOF.map((p) => (
            <li>
              <b>{p.value}</b>
              <span>{p.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <SportTiles />
  <GroupChat />
  <Steps />
  <Venues />
  <Safety items={SAFETY} />
  <Faq items={HOME_FAQ} />
  <DownloadBlock />
</Base>

<style>
  .hero {
    padding-block: clamp(20px, 4vw, 48px) clamp(56px, 8vw, 104px);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .hero__copy {
    max-width: 40rem;
  }

  .hero__sports {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-block-end: 22px;
    color: var(--c-muted);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .hero__sport {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero__sport::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--dot);
  }

  .hero__sport--tennis { --dot: var(--c-tennis); }
  .hero__sport--padel { --dot: var(--c-padel); }
  .hero__sport--badminton { --dot: var(--c-badminton); }
  .hero__sport--squash { --dot: var(--c-squash); }

  .hero h1 {
    font-size: var(--step-5);
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .hero__accent {
    position: relative;
    display: inline-block;
    color: var(--c-court);
  }

  .hero__swash {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -0.08em;
    width: 100%;
    height: 0.24em;
    overflow: visible;
  }

  .hero__swash path {
    fill: none;
    stroke: var(--c-ball);
    stroke-width: 9;
    stroke-linecap: round;
  }

  .hero__lead {
    max-width: 34rem;
    margin-block: 26px 34px;
    color: var(--c-muted);
    font-size: var(--step-1);
    line-height: 1.9;
  }

  .hero__finder {
    margin-block: -10px 22px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
  }

  .hero__note {
    margin-block-start: 18px;
    color: var(--c-muted);
    font-size: var(--step--1);
  }

  .hero__stage {
    position: relative;
    padding: 22px 16px 26px;
    border-radius: 36px;
    background: var(--c-night);
  }

  /* The proof strip: four plain facts between hairlines. */
  .proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: clamp(48px, 7vw, 88px);
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--c-line);
  }

  .proof li {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 20px 4px;
  }

  .proof li:nth-child(odd) {
    padding-inline-end: 16px;
    border-inline-end: 1px solid var(--c-line);
  }

  .proof li:nth-child(even) {
    padding-inline-start: 16px;
  }

  .proof li:nth-child(-n + 2) {
    border-block-end: 1px solid var(--c-line);
  }

  .proof b {
    font: 900 var(--step-2) / 1.5 var(--font-display);
  }

  .proof span {
    color: var(--c-muted);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  /* On load: the swash draws under the accent, then the rest of the copy and the stage settle in. The heading itself
     never waits: it is the page's largest paint. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__swash path {
      stroke-dasharray: 300;
      animation: swash 0.9s 0.35s var(--ease-in-out) both;
    }

    .hero__lead,
    .hero__finder,
    .hero__actions,
    .hero__note,
    .hero__stage {
      animation: settle var(--dur-enter) var(--ease-out) both;
    }

    .hero__lead { animation-delay: 80ms; }
    .hero__finder { animation-delay: 110ms; }
    .hero__actions { animation-delay: 140ms; }
    .hero__note { animation-delay: 200ms; }
    .hero__stage { animation-delay: 120ms; }
  }

  @keyframes swash {
    from { stroke-dashoffset: 300; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (min-width: 720px) {
    .proof {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .proof li,
    .proof li:nth-child(odd),
    .proof li:nth-child(even) {
      padding: 26px 22px;
      border-block-end: 0;
      border-inline-end: 1px solid var(--c-line);
    }

    .proof li:first-child {
      padding-inline-start: 0;
    }

    .proof li:last-child {
      border-inline-end: 0;
    }
  }

  @media (min-width: 1040px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 64px;
    }

    .hero__stage {
      padding: 28px 28px 40px;
    }
  }
</style>
