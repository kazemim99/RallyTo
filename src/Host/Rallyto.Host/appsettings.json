{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=rallyto;Username=rallyto;Password=CHANGE_ME",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_OF_32_CHARS_OR_MORE",
    "Issuer": "rallyto",
    "Audience": "rallyto-clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
